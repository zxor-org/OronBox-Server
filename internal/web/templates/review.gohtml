{{define "review_history"}}
<section class="panel review-history">
  <div class="section-header"><div><h2>处理记录</h2><p>审核单的每一次操作都会留痕，且不可修改。</p></div></div>
  {{if .Events}}
  <ol class="timeline">
    {{range .Events}}
    <li class="timeline-entry">
      <div class="timeline-head"><span class="status {{reviewEventClass .Event}}">{{reviewEventLabel .Event}}</span><time datetime="{{rfc3339 .CreatedAt}}">{{dateTime .CreatedAt}}</time></div>
      <p class="timeline-actor">{{if .Actor}}{{.Actor}}{{else}}系统{{end}}</p>
      {{if .Note}}<p class="timeline-note">{{.Note}}</p>{{end}}
      {{if .Checklist}}<ul class="timeline-checklist">{{range .Checklist}}<li>{{.}}</li>{{end}}</ul>{{end}}
    </li>
    {{end}}
  </ol>
  {{else}}<p class="panel-empty">尚无处理记录。</p>{{end}}
</section>
{{end}}

{{define "admin_review"}}
{{template "admin_open" .}}<header class="page-header"><div><h1>审核中心</h1><p>按超时和优先级排队；批量通过、退回、分配与定优先级都是全有或全无</p></div><span class="count-badge">{{.Page.Total}} 项</span></header>{{if .Decided}}<div class="notice success toast-notice" data-toast>审核决定已保存</div>{{end}}{{if .BulkDone}}<div class="notice success toast-notice" data-toast>批量操作已完成</div>{{end}}<section class="panel list-panel" id="review-queue"><form class="filter-bar embedded" method="get" action="/admin/review" hx-get="/admin/review" hx-target="#review-queue" hx-select="#review-queue" hx-push-url="true" hx-swap="outerHTML"><label class="search-field"><span>搜索</span><input name="q" value="{{.Query.Search}}" placeholder="资源、创作者、修订或审核 ID"></label><label><span>状态</span><select name="state"><option value="">全部</option><option value="pending" {{if eqs .Query.State "pending"}}selected{{end}}>待审核</option><option value="approved" {{if eqs .Query.State "approved"}}selected{{end}}>已通过</option><option value="rejected" {{if eqs .Query.State "rejected"}}selected{{end}}>已拒绝</option><option value="superseded" {{if eqs .Query.State "superseded"}}selected{{end}}>已替代</option></select></label><label><span>类型</span><select name="kind"><option value="">全部</option><option value="quickapp" {{if eqs .Query.Kind "quickapp"}}selected{{end}}>快应用</option><option value="watchface" {{if eqs .Query.Kind "watchface"}}selected{{end}}>表盘</option></select></label><label><span>目标</span><select name="target"><option value="">全部</option><option value="oronbox" {{if eqs .Query.Target "oronbox"}}selected{{end}}>OronBox</option><option value="bandbbs" {{if eqs .Query.Target "bandbbs"}}selected{{end}}>米坛</option><option value="astrobox" {{if eqs .Query.Target "astrobox"}}selected{{end}}>AstroBox</option></select></label><label><span>创作者</span><input name="owner" value="{{.Query.Owner}}"></label><label><span>开始</span><input type="date" name="from" value="{{.From}}"></label><label><span>结束</span><input type="date" name="to" value="{{.To}}"></label><label><span>排序</span><select name="sort"><option value="updated_desc" {{if eqs .Query.Sort "updated_desc"}}selected{{end}}>最近更新</option><option value="sla" {{if eqs .Query.Sort "sla"}}selected{{end}}>最接近超时</option><option value="priority" {{if eqs .Query.Sort "priority"}}selected{{end}}>优先级</option></select></label><div class="filter-actions"><button class="filled-button">应用筛选</button><a class="text-link filter-reset" href="/admin/review">清除</a></div></form><form method="post" action="/admin/review/bulk" hx-post="/admin/review/bulk" hx-target="#review-queue" hx-select="#review-queue" hx-swap="outerHTML"><input type="hidden" name="return_to" value="{{.ReturnTo}}"><div class="bulk-bar" data-bulk-bar data-bulk-noun="个审核单" data-bulk-note-error="批量退回必须填写理由，创作者需要知道要改什么。"><div class="bulk-selection"><span data-bulk-count>未选择</span><span class="bulk-hint">最多 100 项，全有或全无，不会部分成功</span></div><div class="bulk-controls"><label><span>分配给</span><select name="reviewer_id"><option value="">取消分配</option>{{range .Reviewers}}<option value="{{.ID}}">{{.Username}}（{{.Role}}）</option>{{end}}</select></label><button class="outlined-button" name="bulk_action" value="assign">分配</button><label><span>优先级</span><select name="priority"><option value="0">普通</option><option value="1">关注</option><option value="2">高</option><option value="3">紧急</option></select></label><button class="outlined-button" name="bulk_action" value="priority">设为该优先级</button></div><label class="bulk-note"><span>批量退回理由（退回必填，会原样发给创作者）</span><textarea name="note" rows="2" data-bulk-note placeholder="说明需要修改什么，creator 只会看到这段话"></textarea></label><div class="bulk-decisions"><button class="filled-button" name="bulk_action" value="approve" data-confirm="确定批量通过所选审核单吗？">批量通过</button><button class="outlined-button danger" name="bulk_action" value="reject" data-bulk-reject data-confirm="确定批量退回所选审核单吗？">批量退回</button></div></div><div class="table-wrap"><table><thead><tr><th><span class="sr-only">选择</span></th><th>优先级</th><th>资源</th><th>创作者</th><th>等待</th><th>信号</th><th>审核员</th><th>清单</th><th>状态</th><th></th></tr></thead><tbody>{{range .Items}}<tr{{if .Overdue}} class="row-overdue"{{end}}><td>{{if eqs .State "pending"}}<input type="checkbox" name="review_ids" value="{{.ID}}" data-bulk-item aria-label="选择 {{.RevisionName}}">{{end}}</td><td><span class="priority-chip priority-{{.Priority}}">{{.PriorityLabel}}</span></td><td><a class="resource-name" href="/admin/review/{{.ID}}">{{.RevisionName}}</a><span class="cell-note">#{{.RevisionNumber}} · <code>{{.ResourceSlug}}</code></span></td><td>{{.Owner}}<span class="cell-note">{{kindLabel .ResourceKind}} · {{join .Targets " · "}}</span></td><td class="nowrap">{{waited .WaitingFor}}{{if .Overdue}}<span class="cell-note sla-late">已超时</span>{{else if eqs .State "pending"}}<span class="cell-note">{{dateTime .DueAt}} 到期</span>{{end}}</td><td class="signal-cell">{{if .Reports}}<span class="status danger">举报 {{.Reports}}</span>{{end}}{{if .OwnerRejections}}<span class="status warning">退回过 {{.OwnerRejections}}</span>{{end}}{{if and (eqs .Reports 0) (eqs .OwnerRejections 0)}}<span class="secondary">—</span>{{end}}</td><td>{{if .Reviewer}}{{.Reviewer}}{{else}}<span class="secondary">未分配</span>{{end}}</td><td>{{len .Items}} 项</td><td><span class="status {{statusClass .State}}">{{statusLabel .State}}</span></td><td><a class="row-action" href="/admin/review/{{.ID}}">审核</a></td></tr>{{else}}<tr><td class="table-empty" colspan="10">没有符合筛选条件的审核单</td></tr>{{end}}</tbody></table></div></form>{{template "pagination" .}}</section>{{template "admin_close" .}}{{end}}

{{define "admin_review_detail"}}
{{template "admin_open" .}}{{$review := .Detail.Review}}{{$current := .Detail.Current}}
<header class="page-header detail-header"><div><a class="back-link" href="/admin/review">← 审核中心</a><div class="title-line"><h1>{{$current.Name}}</h1><span class="status {{statusClass $review.State}}">{{statusLabel $review.State}}</span></div><p>{{$review.Owner}} · {{kindLabel $review.ResourceKind}} · 修订 #{{$current.Number}}{{if $review.Reviewer}} · 审核员 {{$review.Reviewer}}{{end}}</p></div><div class="header-actions"><a class="outlined-button" href="/admin/resources/{{$review.ResourceID}}" target="_blank">资源工作区</a></div></header>
{{if .Saved}}<div class="notice success toast-notice" data-toast>审核清单已保存，尚未作出决定</div>{{end}}{{if .Action}}<div class="notice success toast-notice" data-toast>审核中的资源修正已保存</div>{{end}}
<div class="metrics"><article><span>元数据</span><strong>{{if .Detail.Diff.MetadataChanged}}有变化{{else}}无变化{{end}}</strong><small>{{join .Detail.Diff.MetadataFields " · "}}</small></article><article><span>媒体</span><strong>{{len $current.Media}} 个</strong><small>+{{.Detail.Diff.Media.Added}} / -{{.Detail.Diff.Media.Removed}}</small></article><article><span>资源文件</span><strong>{{len $current.Artifacts}} 个</strong><small>+{{.Detail.Diff.Artifacts.Added}} / -{{.Detail.Diff.Artifacts.Removed}}</small></article><article><span>设备变化</span><strong>+{{.Detail.Diff.Devices.Added}} / -{{.Detail.Diff.Devices.Removed}}</strong></article></div>

<div class="review-workbench">
<main class="review-workbench-main">
<section class="panel review-submission-summary"><div class="section-header"><div><span class="section-kicker">本次提交</span><h2>{{$current.Name}}</h2></div><span class="status neutral">{{paidTypeLabel $current.PaidType}}</span></div><p class="review-summary-text">{{$current.Summary}}</p>{{if $current.Attributes}}<div class="chip-row">{{range $current.Attributes}}<span class="status neutral">{{.}}</span>{{end}}</div>{{end}}</section>
<section class="panel"><div class="section-header"><div><h2>预览与媒体</h2><p>直接检查创作者提交的实际图片；点击查看原图。</p></div>{{if eqs $review.State "pending"}}<details class="inline-editor"><summary class="outlined-button">上传图片</summary><form method="post" enctype="multipart/form-data" action="/admin/resources/{{$review.ResourceID}}/draft/{{$current.ID}}/media"><input type="hidden" name="return_review" value="{{$review.ID}}"><label><span>角色</span><select name="role"><option value="preview">预览图</option><option value="icon">图标</option><option value="cover">封面</option></select></label><label><span>图片</span><input type="file" name="file" accept="image/png,image/jpeg,image/webp,image/gif" required></label><button class="filled-button">上传</button></form></details>{{end}}</div>{{if $current.Media}}<div class="media-gallery review-media">{{range $current.Media}}<article class="media-preview"><a href="/admin/blobs/{{.SHA256}}" target="_blank" rel="noopener"><img src="/admin/blobs/{{.SHA256}}" alt="{{mediaRoleLabel .Role}} #{{.Position}}" loading="lazy"></a><span>{{mediaRoleLabel .Role}} #{{.Position}} · {{.Width}} × {{.Height}} · {{.SizeBytes}} B</span>{{if eqs $review.State "pending"}}<form method="post" action="/admin/resources/{{$review.ResourceID}}/draft/{{$current.ID}}/media/{{.ID}}/delete"><input type="hidden" name="return_review" value="{{$review.ID}}"><button class="text-link danger" data-confirm="确定移除这张图片吗？">移除</button></form>{{end}}</article>{{end}}</div>{{else}}<div class="empty-state compact"><svg class="icon" aria-hidden="true"><use href="#i-image_not_supported"></use></svg><p>本次提交没有任何图片，审核通过前应确认是否符合资源规范。</p></div>{{end}}</section>

<section class="panel"><div class="section-header"><div><h2>资源文件</h2><p>先确认包本身，再按需展开设备适配；重复上传的同一文件已合并显示。</p></div></div><div class="artifact-review-list">{{range $current.Artifacts}}{{$artifact := .}}<article class="artifact-review-card"><div class="artifact-review-head"><div><strong>{{.OriginalName}}</strong><span class="cell-note"><code>{{.PackageID}}</code> · {{.Version}} · {{.PackageFormat}} · {{.SizeBytes}} B{{if gt .DuplicateCount 1}} · 已合并 {{.DuplicateCount}} 条重复记录{{end}}</span><span class="cell-note truncate-code"><code>{{.SHA256}}</code></span></div><a class="filled-button" href="/admin/blobs/{{.SHA256}}?download=1&amp;name={{urlquery .OriginalName}}">下载文件</a></div><div class="artifact-device-summary"><span class="section-kicker">已绑定设备 {{len .DeviceBindings}} 台</span><div class="chip-row">{{range .DeviceBindings}}<span class="status neutral">{{.DisplayName}} <small>{{.Codename}}</small></span>{{else}}<span class="status danger">未绑定设备</span>{{end}}</div></div><details><summary>查看服务端分析结果</summary><pre class="diagnostic compact-diagnostic">{{prettyJSON .Analysis}}</pre></details>{{if eqs $review.State "pending"}}<details class="artifact-device-editor"><summary class="outlined-button">修改设备适配（{{len $.Devices}} 个可选）</summary><form method="post" action="/admin/resources/{{$review.ResourceID}}/draft/{{$current.ID}}/artifacts/{{.ID}}/devices"><input type="hidden" name="return_review" value="{{$review.ID}}"><fieldset><legend>选择设备</legend><div class="choice-grid compact-choices">{{range $.Devices}}<label class="choice-card"><input type="checkbox" name="device_ids" value="{{.ID}}" {{if containsDevice $artifact.DeviceBindings .ID}}checked{{end}}><span><strong>{{.DisplayName}}</strong><small>{{.Codename}}</small></span></label>{{end}}</div></fieldset><button class="outlined-button">保存设备绑定</button></form></details>{{end}}</article>{{else}}<div class="empty-state compact"><svg class="icon" aria-hidden="true"><use href="#i-deployed_code_alert"></use></svg><p>本次提交没有资源文件，不能完成安装包审核。</p></div>{{end}}</div></section>

<section class="panel"><div class="section-header"><div><h2>发布计划</h2><p>按平台和实际目标阅读；原始配置只保留在高级诊断中。</p></div></div><div class="publication-plan-cards">{{range $current.PublicationPlan}}<article class="publication-plan-card"><div class="title-line"><svg class="icon" aria-hidden="true"><use href="#i-outbox"></use></svg><h3>{{targetLabel .target}}</h3></div>{{if eqs .target "bandbbs"}}<dl class="settings"><dt>发布协议</dt><dd>{{if index .config "agreement"}}已确认{{else}}未确认{{end}}</dd><dt>发布板块</dt><dd><div class="publication-target-list">{{range index .config "targets"}}<div><strong>分类 {{index . "category_id"}}</strong><span>前缀 {{index . "prefix_id"}}</span><code>{{index . "package_id"}}</code></div>{{else}}<span class="row-error">没有配置米坛目标板块</span>{{end}}</div></dd></dl>{{else if eqs .target "astrobox"}}<dl class="settings"><dt>同步平台</dt><dd>AstroBox</dd><dt>付费类型</dt><dd>{{paidTypeLabel $current.PaidType}}<span class="cell-note">免费将按 AstroBox 规则留空</span></dd></dl>{{else}}<dl class="settings"><dt>发布位置</dt><dd>OronBox 主资源库</dd><dt>状态</dt><dd>审核通过后进入发布队列</dd></dl>{{end}}<details><summary>平台高级配置</summary><pre class="diagnostic compact-diagnostic">{{prettyJSON .config}}</pre></details></article>{{else}}<div class="empty-state compact"><p>仅发布到 OronBox，不同步外部平台。</p></div>{{end}}</div><details class="snapshot"><summary>高级：查看完整原始发布配置</summary><pre>{{prettyJSON $current.PublicationPlan}}</pre></details></section>

{{if eqs $review.State "pending"}}<section class="panel"><details class="review-inline-editor"><summary><svg class="icon" aria-hidden="true"><use href="#i-edit_note"></use></svg><strong>修正提交内容</strong><span>修改名称、简介、标签或链接</span></summary><form id="review-correction-form" method="post" action="/admin/resources/{{$review.ResourceID}}/draft" class="revision-editor"><input type="hidden" name="draft_revision_id" value="{{$current.ID}}"><input type="hidden" name="base_revision_id" value="{{$current.BaseRevisionID}}"><input type="hidden" name="return_review" value="{{$review.ID}}"><div class="editor-field-grid"><label><span>资源名称</span><input name="name" value="{{$current.Name}}" maxlength="120" required></label><label><span>付费类型</span><select name="paid_type"><option value="free" {{if eqs $current.PaidType "free"}}selected{{end}}>免费</option><option value="paid" {{if eqs $current.PaidType "paid"}}selected{{end}}>付费</option><option value="force_paid" {{if eqs $current.PaidType "force_paid"}}selected{{end}}>强制付费</option></select></label><label class="span-2"><span>简介</span><textarea name="summary" rows="5" maxlength="4000" required>{{$current.Summary}}</textarea></label></div><fieldset><legend>内容标签</legend><div class="choice-grid">{{range .Attributes}}<label class="choice-card"><input type="checkbox" name="attributes" value="{{.ID}}" {{if containsString $current.Attributes .ID}}checked{{end}}><span><strong>{{.NameZH}}</strong></span></label>{{end}}</div></fieldset><div class="section-header"><h3>外部链接</h3><button class="outlined-button" type="button" data-add-link>添加链接</button></div><div class="link-editor" data-link-list>{{range $current.Links}}<div class="link-row"><input name="link_title" value="{{.Title}}" placeholder="链接标题"><input name="link_url" value="{{.URL}}" type="url" placeholder="https://"><button class="icon-button danger" type="button" data-remove-link><svg class="icon" aria-hidden="true"><use href="#i-delete"></use></svg></button></div>{{end}}<div class="link-row"><input name="link_title" placeholder="链接标题"><input name="link_url" type="url" placeholder="https://"><button class="icon-button danger" type="button" data-remove-link><svg class="icon" aria-hidden="true"><use href="#i-delete"></use></svg></button></div></div><details><summary>高级发布配置</summary><label><span>发布计划 JSON</span><textarea class="json-textarea" name="publication_plan" rows="10" required>{{prettyJSON $current.PublicationPlan}}</textarea></label></details><div class="actions"><button class="filled-button">保存提交修正</button></div></form></details></section>

<section class="panel"><details class="review-inline-editor"><summary><svg class="icon" aria-hidden="true"><use href="#i-policy"></use></svg><strong>治理信息</strong><span>来源、授权、合集与协作者</span></summary><form method="post" action="/admin/resources/{{$review.ResourceID}}/draft/{{$current.ID}}/governance" class="editor-field-grid"><input type="hidden" name="return_review" value="{{$review.ID}}"><label><span>原作者</span><input name="author_name" value="{{$current.Governance.AuthorName}}" maxlength="120"></label><label><span>来源 URL</span><input type="url" name="source_url" value="{{$current.Governance.SourceURL}}"></label><label><span>许可证</span><input name="license_name" value="{{$current.Governance.LicenseName}}" maxlength="120"></label><label><span>所属合集</span><select name="collection_id"><option value="">不属于合集</option>{{range .Collections}}<option value="{{.ID}}" {{if eqs $current.Governance.CollectionID .ID}}selected{{end}}>{{.LatestRevisionName}} · {{.Slug}}</option>{{end}}</select></label><label><span>合集排序</span><input type="number" min="0" name="collection_position" value="{{$current.Governance.CollectionPosition}}"></label><label class="span-2"><span>授权说明</span><textarea name="authorization_note" rows="4">{{$current.Governance.AuthorizationNote}}</textarea></label><label class="span-2"><span>协作者用户 ID</span><textarea name="collaborator_ids" rows="3">{{join $current.Governance.CollaboratorIDs ", "}}</textarea></label><div class="span-2 actions"><button class="outlined-button">保存治理信息</button></div></form></details></section>{{end}}

{{if .Detail.Diff.HasBase}}<section class="panel"><details open><summary><strong>与基础修订对比</strong></summary>
<div class="field-diff-list">
{{range .Detail.Diff.Metadata}}<article class="field-diff"><h3>{{.Label}}</h3><div class="field-diff-pair"><div class="field-diff-before"><span>原</span><pre>{{.Before}}</pre></div><div class="field-diff-after"><span>现</span><pre>{{.After}}</pre></div></div></article>{{end}}
{{range .Detail.Diff.AttributeItems}}<article class="field-diff {{.Change}}"><h3>标签</h3><p>{{if eqs .Change "added"}}新增 {{.After}}{{else if eqs .Change "removed"}}移除 {{.Before}}{{else}}{{.Before}} → {{.After}}{{end}}</p></article>{{end}}
{{range .Detail.Diff.LinkItems}}<article class="field-diff {{.Change}}"><h3>链接</h3><p>{{if eqs .Change "added"}}新增 {{.After}}{{else if eqs .Change "removed"}}移除 {{.Before}}{{else}}{{.Before}} → {{.After}}{{end}}</p></article>{{end}}
{{range .Detail.Diff.MediaItems}}<article class="field-diff {{.Change}}"><h3>媒体</h3><p>{{if eqs .Change "added"}}新增 {{.After}}{{else if eqs .Change "removed"}}移除 {{.Before}}{{else}}{{.Before}} → {{.After}}{{end}}</p></article>{{end}}
{{range .Detail.Diff.ArtifactItems}}<article class="field-diff {{.Change}}"><h3>安装包</h3><p>{{if eqs .Change "added"}}新增 {{.After}}{{else if eqs .Change "removed"}}移除 {{.Before}}{{else}}{{.Before}} → {{.After}}{{end}}</p></article>{{end}}
{{range .Detail.Diff.DeviceItems}}<article class="field-diff {{.Change}}"><h3>设备</h3><p>{{if eqs .Change "added"}}新增 {{.After}}{{else if eqs .Change "removed"}}移除 {{.Before}}{{else}}{{.Before}} → {{.After}}{{end}}</p></article>{{end}}
{{if and (not .Detail.Diff.Metadata) (not .Detail.Diff.AttributeItems) (not .Detail.Diff.LinkItems) (not .Detail.Diff.MediaItems) (not .Detail.Diff.ArtifactItems) (not .Detail.Diff.DeviceItems)}}<p class="muted">与基础修订相比没有字段变化。</p>{{end}}
</div></details></section>{{end}}
</main>

<aside class="review-decision-rail">{{if eqs $review.State "pending"}}<section class="panel sticky-review-decision" id="review-decision"><div class="section-header"><div><h2>审核决定</h2><p>检查、修正和决定都在此页完成。改清单后不必先保存，批准会带上当前勾选。</p></div></div>
<form method="post" action="/admin/review/{{$current.ID}}" class="review-decision-form" id="review-decision-form">
<fieldset class="checklist-grid"><legend>审核清单</legend>
{{range defaultReviewChecklist}}<label class="choice-card"><input type="checkbox" name="item" value="{{.}}" {{if containsString $review.Items .}}checked{{end}}><span><strong>{{.}}</strong></span></label>{{end}}
</fieldset>
<label><span>补充检查项</span><textarea name="items" rows="3" placeholder="每行一项，会与上面的勾选合并">{{join (extraReviewItems $review.Items) "\n"}}</textarea></label>
<fieldset><legend>确认标签</legend><div class="choice-grid compact-choices">{{range $.Attributes}}<label class="choice-card"><input type="checkbox" name="attributes" value="{{.ID}}" {{if containsString $current.Attributes .ID}}checked{{end}}><span><strong>{{.NameZH}}</strong></span></label>{{end}}</div></fieldset>
<label><span>策展等级</span><select name="curation_grade"><option value="standard" {{if eqs $review.CurationGrade "standard"}}selected{{end}}>普通</option><option value="featured" {{if eqs $review.CurationGrade "featured"}}selected{{end}}>精选</option></select></label>
<label><span>审核意见</span><textarea name="note" rows="6" data-required-for="reject" placeholder="退回时请说明需要修改的内容"></textarea></label>
<div class="decision-actions">
<button class="outlined-button" type="submit" formaction="/admin/review/{{$review.ID}}/checklist" hx-post="/admin/review/{{$review.ID}}/checklist" hx-target="#review-decision" hx-select="#review-decision" hx-swap="outerHTML">保存检查进度</button>
<button class="filled-button" name="decision" value="approve" data-confirm="确认已检查图片、资源文件、设备和发布计划，并批准此修订？">批准发布</button>
<button class="outlined-button danger" name="decision" value="reject">退回修改</button>
</div>
</form></section>{{else}}<section class="panel sticky-review-decision"><h2>审核结果</h2><dl class="settings"><dt>审核员</dt><dd>{{$review.Reviewer}}</dd><dt>意见</dt><dd>{{$review.Note}}</dd><dt>检查项</dt><dd>{{join $review.Items "；"}}</dd></dl></section>{{end}}{{template "review_history" .}}</aside>
</div>
{{template "admin_close" .}}{{end}}

ADDR=:8080
PUBLIC_URL=https://ob-api.zxor.org
DATABASE_URL=postgres://oronbox:oronbox@127.0.0.1:5432/oronbox?sslmode=disable

# At least 32 random bytes each. Production refuses placeholder values.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

APP_VERSION=dev
GIT_COMMIT=
LOG_LEVEL=info
# text for terminals/systemd, json for structured log collectors
LOG_FORMAT=text
BANDBBS_CLIENT_ID=
BANDBBS_CLIENT_SECRET=
BANDBBS_REDIRECT_URI=https://ob-api.zxor.org/oauth2/bandbbs/callback
BANDBBS_AUTHORIZE_URL=https://www.bandbbs.cn/oauth2/authorize
BANDBBS_TOKEN_URL=https://www.bandbbs.cn/api/oauth2/token
BANDBBS_ME_URL=https://www.bandbbs.cn/api/me
BANDBBS_API_URL=https://www.bandbbs.cn/api
BANDBBS_INTROSPECT_URL=https://www.bandbbs.cn/api/oauth2/introspect
BANDBBS_REVOKE_URL=https://www.bandbbs.cn/api/oauth2/revoke
# Read-only scopes; the access token is handed to the client, the refresh token stays encrypted on the server
BANDBBS_SCOPES=user:read resource_check:read resource:read resource_category:read resource_rating:read thread:read
# Write scopes; authorized separately for publication and never returned to the client
BANDBBS_PUBLISH_SCOPES=attachment:write resource:write

CLIENT_REDIRECT_URI=oronbox://oauth/bandbbs
# Browser origins allowed to call the API and receive OAuth callbacks
WEB_CLIENT_ORIGINS=https://oronbox.zxor.org
# Only these direct proxy peers may supply CF/X-Forwarded-For/X-Real-IP
TRUSTED_PROXY_CIDRS=
STATE_TTL=10m
LOGIN_TICKET_TTL=3m
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RETENTION_UNPUBLISHED=4320h
RETENTION_AUDIT=4320h
RETENTION_FEEDBACK=8760h
RETENTION_ORPHAN_BLOBS=168h
RETENTION_INTERVAL=6h

# Authoritative local blob storage
STORAGE_LOCAL_ROOT=/var/lib/oronbox/blobs
UPLOAD_MAX_BYTES=104857600
PREVIEW_MAX_BYTES=10485760
PREVIEW_MAX_COUNT=12

# Optional Cloudflare R2 published replica. Keep the bucket private: downloads
# are served through short-lived presigned URLs issued by /api/blobs.
R2_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=oronbox-resources
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Download signing endpoint limits
DOWNLOAD_RATE_PER_MINUTE=30
DOWNLOAD_DAILY_LIMIT=200
DOWNLOAD_PRESIGN_TTL=10m

# Optional synchronous comment moderation (OpenAI-compatible APIs)
MODERATION_BASE_URL=https://api.deepseek.com
MODERATION_API_KEY=
MODERATION_MODEL=deepseek-v4-flash
MODERATION_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODERATION_FALLBACK_API_KEY=
MODERATION_FALLBACK_MODEL=glm-4-flash
MODERATION_TIMEOUT=4s

# Recommendation score multipliers (defaults shown). Score formula:
# engagement(coins extra weight, download weight) x freshness(amplitude x
# exp(-age_days/decay_days)) x featured boost x attribute coefficients x
# jitter(base + seed hash). Values can be overridden at runtime from the
# admin console settings page (server_settings table).
RANKING_COIN_EXTRA_WEIGHT=0.35
RANKING_DOWNLOAD_WEIGHT=0.15
RANKING_FRESHNESS_AMPLITUDE=3.0
RANKING_FRESHNESS_DECAY_DAYS=7.0
RANKING_FEATURED_BOOST=1.5
RANKING_JITTER_BASE=0.5

# AstroBox GitHub publishing
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://ob-api.zxor.org/oauth2/github/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_DEVICE_CODE_URL=https://github.com/login/device/code
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_URL=https://api.github.com
GITHUB_SCOPES=repo read:user
ASTROBOX_REPO_OWNER=AstralSightStudios
ASTROBOX_REPO_NAME=AstroBox-Repo
ASTROBOX_REPO_BRANCH=main
ASTROBOX_CATALOG_PATH=index_v2.csv

# BandBBS user IDs bootstrapped as OronBox administrators

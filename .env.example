# Deployment
ADDR=:8080
PUBLIC_URL=https://ob-api.zxor.org
DATABASE_URL=postgres://oronbox:oronbox@127.0.0.1:5432/oronbox?sslmode=disable
WEB_CLIENT_ORIGINS=https://oronbox.zxor.org
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ADMIN_BANDBBS_USER_IDS=

# Secrets: preserve existing values when upgrading.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Exactly 64 hexadecimal characters; also used by trusted client release CI.
ORONBOX_AUTH_MASTER=

# OAuth application credentials and registered callbacks
BANDBBS_CLIENT_ID=
BANDBBS_CLIENT_SECRET=
BANDBBS_REDIRECT_URI=https://ob-api.zxor.org/oauth2/bandbbs/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://ob-api.zxor.org/oauth2/github/callback
CLIENT_REDIRECT_URI=oronbox://oauth/bandbbs

# Persistent local storage and private R2 binary replicas
STORAGE_LOCAL_ROOT=/var/lib/oronbox/blobs
CONSOLE_DIR=/var/lib/oronbox/console
R2_ENABLED=true
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=oronbox
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Configuration catalog and Console Release access
GITEA_URL=https://git.zxor.org
GITEA_BOT_TOKEN=

# Optional AI credentials used until configuration is saved in Console
# MODERATION_API_KEY=
# MODERATION_FALLBACK_API_KEY=

# Optional operational overrides; built-in defaults apply when omitted.
# LOG_LEVEL=info
# LOG_FORMAT=text
